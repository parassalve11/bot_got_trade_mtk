# Generate two different secrets: python -m app.cli init-config
WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
TRADING_MODE=DISABLED
ALLOW_LIVE_TRADING=false
TRADING_ENABLED=false

DATABASE_PATH=data/trading.db
SYMBOLS_PATH=config/symbols.json
LOG_DIRECTORY=logs
MAGIC_NUMBER=26093001

# Required when connecting to MT5. Never put these in a TradingView message.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=10000
# Verified broker timestamp offset from UTC, in seconds. Default assumes UTC.
# Recheck after broker/server or daylight-saving changes; do not loosen quote freshness.
MT5_SERVER_UTC_OFFSET_SECONDS=0

MAX_RISK_PERCENT=0.50
MAX_TOTAL_RISK_PERCENT=2.00
# Optional: size every trade as if the account held only this much (e.g. 1000 on a 100k demo).
# RISK_CAPITAL=1000
# Small accounts: allow the broker's minimum lot when it risks at most this % of capital (0 = skip).
MIN_LOT_MAX_RISK_PERCENT=0
MAX_DAILY_LOSS_PERCENT=3.00
MAX_DAILY_ENTRIES=10
MAX_OPEN_POSITIONS=5
MAX_LOT=1.0
MAX_MARGIN_FRACTION=0.80
MAX_DEVIATION_POINTS=20
RISK_COST_BUFFER_PERCENT=10
MAX_EVENT_AGE_SECONDS=120
MAX_SIGNAL_AGE_SECONDS=300
MAX_FUTURE_SKEW_SECONDS=15
MAX_TICK_AGE_SECONDS=15
MAX_RETRIES=5
RETRY_BASE_SECONDS=2
WORKER_POLL_SECONDS=1
WORKER_HEALTH_SECONDS=30
MAX_BODY_BYTES=16384
MAX_QUEUE_SIZE=10000

# JSON lists. Exact values, no wildcards. Add each enabled chart instance.
ALLOWED_STRATEGIES=["bytefx_ut_multi_asset"]
ALLOWED_VERSIONS=["1.1.0"]
ALLOWED_INSTANCES=["main"]
ALLOWED_TIMEFRAMES=["15","60","240"]

# App sees loopback because Caddy enforces the PUBLIC TradingView IP allowlist.
# For direct testing, only loopback peers are accepted. X-Forwarded-For is ignored.
WEBHOOK_ALLOWED_IPS=["127.0.0.1","::1"]
ENABLE_DOCS=false

# Built-in signal engine: generates UT Bot signals from MT5 candles (no TradingView needed).
# off = disabled, watch = log signals to the audit log only, trade = place orders.
# Strategy settings per symbol/timeframe live in config/engine.json.
ENGINE_MODE=off
ENGINE_CONFIG_PATH=config/engine.json

# Dashboard (Next.js on Vercel -> Tailscale Funnel -> this API at /api/v1/dash).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(40))" and put the SAME value
# in Vercel as DASH_PROXY_SECRET. Empty = dashboard API disabled (404).
DASH_PROXY_SECRET=
DASH_SESSION_HOURS=12
# After the PC was off (bot offline > 10 min) the bot stays STOPPED until you press Start on the dashboard.
STOP_ON_PC_RESTART=true
