//@version=6
indicator("LK Sniper", overlay=true, max_lines_count=20, max_labels_count=500)

// ── 01. TREND ENGINE ────────────────────────────────────────

gEngine = "01. Trend Engine"

trendLength = input.int(34, "Trend Length", minval=10, maxval=200, group=gEngine,
     tooltip="Controls the primary trend baseline. Higher values create slower and more stable trend states.")

momentumLength = input.int(12, "Momentum Length", minval=3, maxval=100, group=gEngine,
     tooltip="Lookback used to measure directional momentum.")

sensitivity = input.float(0.35, "Signal Selectivity", minval=0.10, maxval=1.25, step=0.05, group=gEngine,
     tooltip="Controls how much directional evidence is required before the trend can reverse. Higher values produce fewer signals.")

// ── 02. SUPERTREND CONFIRMATION ────────────────────────────────────────

gST = "02. Supertrend Confirmation"

stFastLength = input.int(9, "Fast Length", minval=2, maxval=100, group=gST,
     tooltip="ATR length of the fast hidden Supertrend. Lower values react more quickly.")

stFastFactor = input.float(1.45, "Fast Factor", minval=0.25, maxval=10.0, step=0.05, group=gST,
     tooltip="Base ATR multiplier of the fast hidden Supertrend. Higher values require a larger move before its direction changes.")

stMidLength = input.int(14, "Medium Length", minval=2, maxval=150, group=gST,
     tooltip="ATR length of the medium hidden Supertrend.")

stMidFactor = input.float(1.95, "Medium Factor", minval=0.25, maxval=10.0, step=0.05, group=gST,
     tooltip="Base ATR multiplier of the medium hidden Supertrend.")

stSlowLength = input.int(21, "Slow Length", minval=2, maxval=200, group=gST,
     tooltip="ATR length of the slow hidden Supertrend. This acts as the broader continuation confirmation.")

stSlowFactor = input.float(2.55, "Slow Factor", minval=0.25, maxval=10.0, step=0.05, group=gST,
     tooltip="Base ATR multiplier of the slow hidden Supertrend. Higher values make broader trend confirmation more selective.")

// ── 03. OVERLAY ────────────────────────────────────────

gOverlay = "03. Overlay"

overlayMode = input.string("Trail", "Overlay", options=["Trail", "Bands", "None"], group=gOverlay,
     tooltip="Trail displays the complete trend ribbon with depth. Bands displays layered volatility zones. None hides the overlay.")

trailSize = input.float(1.00, "Width", minval=0.40, maxval=2.50, step=0.05, group=gOverlay,
     tooltip="Controls the overall distance and thickness of the selected overlay.")

smoothness = input.int(5, "Smoothness", minval=1, maxval=20, group=gOverlay,
     tooltip="Smooths the overlay geometry. Higher values create softer movement.")

// Trade display. Targets use the first indicator's fixed 1R / 2R / 3R model.
const string gTrade = "04. Trade Levels & Panel"
showSignals = input.bool(true, "Show UP / DOWN Signals", group=gTrade)
showLevels = input.bool(true, "Show Entry / SL / TP", group=gTrade)
showPanel = input.bool(true, "Show Trade Panel", group=gTrade)
panelPosition = input.string("Top Right", "Panel Position",
     options=["Top Left", "Top Center", "Top Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=gTrade)

// Stop distance is a risk decision, so it is an input of its own rather than a
// side effect of the Overlay Width. It used to be read off the drawn ribbon,
// which meant widening the ribbon for looks also moved the stop and all three
// targets -- and with the overlay set to None it moved a line nobody could see.
slAtrMult = input.float(1.15, "Stop Loss Distance (ATR)", minval=0.20, maxval=5.00, step=0.05, group=gTrade,
     tooltip="Distance from the trend baseline to the stop, in ATR. This is a risk setting and is independent of the Overlay settings, which only change how the chart is drawn. Targets are 1R / 2R / 3R of whatever risk this produces.")

const color ENTRY_COLOR = #2962FF
const color TP_COLOR = #16A34A
const color SL_COLOR = #F44336
const color PANEL_BG = #111827
const color PANEL_ALT = #172033
const color PANEL_TEXT = #E5E7EB


// ── COLORS ────────────────────────────────────────

bullColor = #00FFE5
bearColor = color.rgb(252, 125, 125)
neutralColor = #FFD84D

black = #000000
white = #FFFFFF

// ── HELPERS ────────────────────────────────────────

f_clamp(_v, _min, _max) =>
    math.max(_min, math.min(_max, _v))

f_position(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Top Center" ? position.top_center :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Bottom Center" ? position.bottom_center :
     _p == "Bottom Right" ? position.bottom_right :
     position.top_right

// ── BASE MARKET STATE ────────────────────────────────────────

basis = ta.ema(close, trendLength)

atr = ta.atr(14)
safeATR = math.max(atr, syminfo.mintick)

momentum = ta.ema(close - close[momentumLength], 5) / safeATR
distance = (close - basis) / safeATR

// ── DIRECTIONAL EFFICIENCY ────────────────────────────────────────

effLength = 10

netMovement = math.abs(close - close[effLength])
travelPath = math.sum(math.abs(close - close[1]), effLength)

efficiency = travelPath > 0.0 ? f_clamp(netMovement / travelPath, 0.0, 1.0) : 0.0
chop = 1.0 - efficiency

effDirection = close > close[effLength] ? 1.0 :
     close < close[effLength] ? -1.0 : 0.0

efficiencyField = efficiency * effDirection

// ── VOLATILITY REGIME ────────────────────────────────────────

normalATR = ta.ema(safeATR, 50)
volRatio = normalATR > 0.0 ? safeATR / normalATR : 1.0

volExpansion = f_clamp(volRatio - 1.0, 0.0, 1.25)
volDeviation = f_clamp(math.abs(volRatio - 1.0), 0.0, 1.50)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ADAPTIVE SUPERTREND MATRIX
//
// User inputs define each Supertrend's base parameters.
// Chop and volatility then add a small dynamic distance adjustment.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fastAdaptiveFactor = stFastFactor + chop * 0.25 + volExpansion * 0.10
midAdaptiveFactor = stMidFactor + chop * 0.35 + volExpansion * 0.15
slowAdaptiveFactor = stSlowFactor + chop * 0.45 + volExpansion * 0.20

[stFast, stFastDirection] = ta.supertrend(fastAdaptiveFactor, stFastLength)
[stMid, stMidDirection] = ta.supertrend(midAdaptiveFactor, stMidLength)
[stSlow, stSlowDirection] = ta.supertrend(slowAdaptiveFactor, stSlowLength)

stFastBull = stFastDirection < 0
stFastBear = stFastDirection > 0

stMidBull = stMidDirection < 0
stMidBear = stMidDirection > 0

stSlowBull = stSlowDirection < 0
stSlowBear = stSlowDirection > 0

bullSTVotes = (stFastBull ? 1 : 0) + (stMidBull ? 1 : 0) + (stSlowBull ? 1 : 0)
bearSTVotes = (stFastBear ? 1 : 0) + (stMidBear ? 1 : 0) + (stSlowBear ? 1 : 0)

// Clean/normal markets = 2/3.
// Very choppy markets = 3/3.
requiredSTVotes = chop > 0.70 ? 3 : 2

bullSTConfirmed = bullSTVotes >= requiredSTVotes
bearSTConfirmed = bearSTVotes >= requiredSTVotes

fullBullST = bullSTVotes == 3
fullBearST = bearSTVotes == 3

// ── SUPERTREND PERSISTENCE ────────────────────────────────────────

var int bullSTBars = 0
var int bearSTBars = 0

if barstate.isconfirmed
    bullSTBars := bullSTConfirmed ? math.min(bullSTBars + 1, 5) : 0
    bearSTBars := bearSTConfirmed ? math.min(bearSTBars + 1, 5) : 0

stPersistenceRequired = chop > 0.72 ? 2 : 1

bullSTPersistent = bullSTBars >= stPersistenceRequired
bearSTPersistent = bearSTBars >= stPersistenceRequired

// ── CORE REGIME COMPONENTS ────────────────────────────────────────

distanceField = f_clamp(distance / 1.20, -1.0, 1.0)
momentumField = f_clamp(momentum / 0.35, -1.0, 1.0)

basisSlope = (basis - basis[3]) / safeATR
slopeField = f_clamp(basisSlope / 0.25, -1.0, 1.0)

rsi = ta.rsi(close, 14)
rsiField = f_clamp((rsi - 50.0) / 20.0, -1.0, 1.0)

// ── SUPERTREND CONSENSUS FIELD ────────────────────────────────────────

stField = (bullSTVotes - bearSTVotes) / 3.0

slowCenter = ta.ema(hl2, math.max(10, int(math.round(trendLength * 0.70))))

slowSlope = (slowCenter - slowCenter[3]) / safeATR
slowSlopeField = f_clamp(slowSlope / 0.25, -1.0, 1.0)

// ── STRUCTURE BONUS ────────────────────────────────────────

structureLength = math.max(3, int(math.round(trendLength * 0.12)))

recentHigh = ta.highest(high[1], structureLength)
recentLow = ta.lowest(low[1], structureLength)

bullStructure = close > recentHigh
bearStructure = close < recentLow

structureField = bullStructure ? 1.0 :
     bearStructure ? -1.0 : 0.0

// ── CANDLE PRESSURE ────────────────────────────────────────

barRange = math.max(high - low, syminfo.mintick)

bodyPressure = (close - open) / barRange
closeLocation = ((close - low) / barRange - 0.50) * 2.0

pressureField = f_clamp(bodyPressure * 0.60 + closeLocation * 0.40, -1.0, 1.0)

// ── COMPOSITE REGIME ────────────────────────────────────────

rawRegime =
     distanceField * 0.22 +
     momentumField * 0.19 +
     slopeField * 0.14 +
     slowSlopeField * 0.10 +
     rsiField * 0.08 +
     efficiencyField * 0.09 +
     pressureField * 0.05 +
     structureField * 0.05 +
     stField * 0.20

regime = ta.ema(rawRegime, 3)

// ── DYNAMIC HYSTERESIS ────────────────────────────────────────

chopPenalty = chop * 0.085
volPenalty = f_clamp(volDeviation * 0.04, 0.0, 0.06)

dynamicGate = 0.22 + sensitivity * 0.12 + chopPenalty + volPenalty

bullZone = regime > dynamicGate
bearZone = regime < -dynamicGate

bullPriceOK = close > basis + safeATR * sensitivity * 0.30
bearPriceOK = close < basis - safeATR * sensitivity * 0.30

// ── SIGNAL CANDIDATES ────────────────────────────────────────

bullCandidate = bullZone and bullPriceOK and momentum > 0.025 and bullSTPersistent
bearCandidate = bearZone and bearPriceOK and momentum < -0.025 and bearSTPersistent

// ── DYNAMIC CONFIRMATION ────────────────────────────────────────

requiredBars = chop > 0.72 ? 3 :
     chop > 0.40 ? 2 : 1

var int bullConfirm = 0
var int bearConfirm = 0

if barstate.isconfirmed
    bullConfirm := bullCandidate ? math.min(bullConfirm + 1, 4) : 0
    bearConfirm := bearCandidate ? math.min(bearConfirm + 1, 4) : 0

bullPersistent = bullConfirm >= requiredBars
bearPersistent = bearConfirm >= requiredBars

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STRONG MOVE FAST PASS
//
// Still requires unanimous 3/3 Supertrend confirmation.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

strongBull =
     bullCandidate and
     fullBullST and
     regime > dynamicGate + 0.26 and
     momentum > 0.16 and
     efficiency > 0.42

strongBear =
     bearCandidate and
     fullBearST and
     regime < -(dynamicGate + 0.26) and
     momentum < -0.16 and
     efficiency > 0.42

bullReady = bullPersistent or strongBull
bearReady = bearPersistent or strongBear

// ── SUPERTREND TAKEOVER ────────────────────────────────────────

bullTakeover = stFastBull and (stMidBull or stSlowBull)
bearTakeover = stFastBear and (stMidBear or stSlowBear)

bullReady := bullReady and bullTakeover
bearReady := bearReady and bearTakeover

// ── ADAPTIVE COOLDOWN ────────────────────────────────────────

cooldownBars = 6 + int(math.round(chop * 4.0))

var int trend = 0
var int lastFlipBar = na

barsSinceFlip = na(lastFlipBar) ? 100000 : bar_index - lastFlipBar
cooldownDone = barsSinceFlip >= cooldownBars

if barstate.isconfirmed
    if trend != 1 and bullReady and (cooldownDone or strongBull)
        trend := 1
        lastFlipBar := bar_index

        bullConfirm := 0
        bearConfirm := 0
        bullSTBars := 0
        bearSTBars := 0

    else if trend != -1 and bearReady and (cooldownDone or strongBear)
        trend := -1
        lastFlipBar := bar_index

        bullConfirm := 0
        bearConfirm := 0
        bullSTBars := 0
        bearSTBars := 0

bullish = trend == 1
bearish = trend == -1

upSignal = barstate.isconfirmed and trend == 1 and trend[1] != 1
downSignal = barstate.isconfirmed and trend == -1 and trend[1] != -1

trendColor = bullish ? bullColor :
     bearish ? bearColor :
     neutralColor

// ── SMOOTH OVERLAY ────────────────────────────────────────

smoothBasis = smoothness > 1 ? ta.ema(basis, smoothness) : basis
smoothATR = smoothness > 1 ? ta.ema(safeATR, smoothness) : safeATR

innerDistance = 0.55 * trailSize
outerDistance = 1.15 * trailSize
depthDistance = 1.60 * trailSize

innerTrail = bullish ? smoothBasis - smoothATR * innerDistance :
     bearish ? smoothBasis + smoothATR * innerDistance :
     smoothBasis

outerTrail = bullish ? smoothBasis - smoothATR * outerDistance :
     bearish ? smoothBasis + smoothATR * outerDistance :
     smoothBasis

depthTrail = bullish ? smoothBasis - smoothATR * depthDistance :
     bearish ? smoothBasis + smoothATR * depthDistance :
     smoothBasis

// Measured from the raw baseline and ATR, not the smoothed overlay geometry,
// so neither Width nor Smoothness can move a stop loss.
slAnchor = bullish ? basis - safeATR * slAtrMult :
     bearish ? basis + safeATR * slAtrMult :
     basis

showTrail = overlayMode == "Trail"
showBands = overlayMode == "Bands"

// ── TRAIL ────────────────────────────────────────

pTrailInner = plot(showTrail ? innerTrail : na, "Trail Inner", color=color.new(trendColor, 100))
pTrailOuter = plot(showTrail ? outerTrail : na, "Trail Outer", color=color.new(trendColor, 100))
pTrailDepth = plot(showTrail ? depthTrail : na, "Trail Depth", color=color.new(trendColor, 100))

fill(pTrailInner, pTrailOuter, color=color.new(trendColor, 68), title="Trend Trail")
fill(pTrailOuter, pTrailDepth, color=color.new(trendColor, 87), title="Trail Depth")

// ── BANDS ────────────────────────────────────────

bandBasis = ta.ema(smoothBasis, smoothness)
bandATR = ta.ema(smoothATR, smoothness)

upper1 = bandBasis + bandATR * 1.30 * trailSize
upper2 = bandBasis + bandATR * 2.00 * trailSize
upper3 = bandBasis + bandATR * 2.90 * trailSize

lower1 = bandBasis - bandATR * 1.30 * trailSize
lower2 = bandBasis - bandATR * 2.00 * trailSize
lower3 = bandBasis - bandATR * 2.90 * trailSize

pU1 = plot(showBands ? upper1 : na, "Upper Band 1", color=color.new(bearColor, 100))
pU2 = plot(showBands ? upper2 : na, "Upper Band 2", color=color.new(bearColor, 100))
pU3 = plot(showBands ? upper3 : na, "Upper Band 3", color=color.new(bearColor, 100))

pL1 = plot(showBands ? lower1 : na, "Lower Band 1", color=color.new(bullColor, 100))
pL2 = plot(showBands ? lower2 : na, "Lower Band 2", color=color.new(bullColor, 100))
pL3 = plot(showBands ? lower3 : na, "Lower Band 3", color=color.new(bullColor, 100))

fill(pU1, pU2, color=color.new(bearColor, 91), title="Upper Inner Band")
fill(pU2, pU3, color=color.new(bearColor, 72), title="Upper Outer Band")

fill(pL1, pL2, color=color.new(bullColor, 91), title="Lower Inner Band")
fill(pL2, pL3, color=color.new(bullColor, 72), title="Lower Outer Band")

// ── SIGNAL LABELS ────────────────────────────────────────

signalPadding = smoothATR * 1.05

if showSignals and upSignal
    label.new(bar_index, outerTrail - signalPadding, "UP",
         style=label.style_label_up,
         color=bullColor,
         textcolor=black,
         size=size.normal)

if showSignals and downSignal
    label.new(bar_index, outerTrail + signalPadding, "DOWN",
         style=label.style_label_down,
         color=bearColor,
         textcolor=white,
         size=size.normal)


// ── TRADE HELPERS ───────────────────────────────────────────────
// This indicator tracks price touches; it does not simulate order fills or P&L.
const string ALERT_TEMPLATE = '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"{3}","entry":"{4}","tp1":"{5}","tp2":"{6}","tp3":"{7}","sl":"{8}","price":"{9}"'

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

// The panel can show an em dash for "no value"; a webhook consumer parsing the
// alert JSON cannot, so the payload uses an empty string instead.
f_priceJson(float value) =>
    na(value) ? "" : str.tostring(value, format.mintick)

f_notify(string action, int side, float entry, float sl, float tp1, float tp2, float tp3, float eventPrice) =>
    string payload = str.format(ALERT_TEMPLATE, action, syminfo.tickerid, timeframe.period,
         side == 1 ? "long" : "short", f_priceJson(entry), f_priceJson(tp1), f_priceJson(tp2), f_priceJson(tp3), f_priceJson(sl), f_priceJson(eventPrice))
    // Called only on confirmed bars. Allow separate TP1/TP2/TP3 events on one bar.
    alert("{" + payload + "}", alert.freq_all)

f_panelRow(table panel, int row, string caption, string value, color valueColor) =>
    color rowBg = row % 2 == 0 ? PANEL_BG : PANEL_ALT
    table.cell(panel, 0, row, caption, text_color=PANEL_TEXT, bgcolor=rowBg, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, row, value, text_color=valueColor, bgcolor=rowBg, text_size=size.small, text_halign=text.align_right)

// ── TRADE STATE ─────────────────────────────────────────────────
var int tradeSide = 0
var int tradeBar = na
var int tradeEndBar = na
var float tradeEntry = na
var float tradeSL = na
var float tradeTP1 = na
var float tradeTP2 = na
var float tradeTP3 = na
var float tradeRisk = na
var bool tradeOpen = false
var bool tp1Done = false
var bool tp2Done = false
var bool tp3Done = false
var bool slDone = false
var string tradeStatus = "WAITING FOR SIGNAL"

// These event flags reset on every execution; persistent hit flags reset per trade.
bool tp1Event = false
bool tp2Event = false
bool tp3Event = false
bool slEvent = false
bool reversalEvent = false

// ── TRADE EVENTS ────────────────────────────────────────────────
// Entry is the signal bar's close. Its earlier high/low cannot hit new targets.
// If a subsequent candle touches both SL and a target, use SL-first handling.
// This is a conservative OHLC assumption, not a claim about intrabar order.
if barstate.isconfirmed and tradeOpen and bar_index > tradeBar
    bool stopTouched = tradeSide == 1 ? low <= tradeSL : high >= tradeSL
    if stopTouched
        slDone := true
        slEvent := true
        tradeOpen := false
        tradeEndBar := bar_index
        tradeStatus := "SL HIT"
        f_notify("slhit", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, tradeSL)
    else
        if not tp1Done and (tradeSide == 1 ? high >= tradeTP1 : low <= tradeTP1)
            tp1Done := true
            tp1Event := true
            tradeStatus := "TP1 HIT / ACTIVE"
            f_notify("tp1hit", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, tradeTP1)
        if not tp2Done and (tradeSide == 1 ? high >= tradeTP2 : low <= tradeTP2)
            tp2Done := true
            tp2Event := true
            tradeStatus := "TP2 HIT / ACTIVE"
            f_notify("tp2hit", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, tradeTP2)
        if not tp3Done and (tradeSide == 1 ? high >= tradeTP3 : low <= tradeTP3)
            tp3Done := true
            tp3Event := true
            tradeOpen := false
            tradeEndBar := bar_index
            tradeStatus := "TP3 HIT / COMPLETE"
            f_notify("tp3hit", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, tradeTP3)

    // Process the old trade before an opposite signal replaces its levels.
    if tradeOpen and (tradeSide == 1 ? downSignal : upSignal)
        tradeOpen := false
        tradeEndBar := bar_index
        reversalEvent := true
        tradeStatus := "CLOSED / REVERSAL"
        f_notify(tradeSide == 1 ? "closelong" : "closeshort", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, close)

if upSignal or downSignal
    tradeSide := upSignal ? 1 : -1
    tradeBar := bar_index
    tradeEndBar := na
    tradeEntry := math.round_to_mintick(close)
    float minimumRisk = syminfo.mintick * 10.0
    float stopAnchor = nz(slAnchor, tradeEntry - tradeSide * safeATR)
    tradeSL := math.round_to_mintick(tradeSide == 1 ? math.min(stopAnchor, tradeEntry - minimumRisk) : math.max(stopAnchor, tradeEntry + minimumRisk))
    tradeRisk := math.abs(tradeEntry - tradeSL)
    tradeTP1 := math.round_to_mintick(tradeEntry + tradeSide * tradeRisk)
    tradeTP2 := math.round_to_mintick(tradeEntry + tradeSide * tradeRisk * 2.0)
    tradeTP3 := math.round_to_mintick(tradeEntry + tradeSide * tradeRisk * 3.0)
    tradeOpen := true
    tp1Done := false
    tp2Done := false
    tp3Done := false
    slDone := false
    tradeStatus := "ACTIVE"
    f_notify(upSignal ? "long" : "short", tradeSide, tradeEntry, tradeSL, tradeTP1, tradeTP2, tradeTP3, tradeEntry)

// ── LATEST TRADE LEVELS ─────────────────────────────────────────
// Drawings are independent of tracking, so hiding levels does not stop alerts.
var line slLine = na
var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var label slLabel = na
var label entryLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na
var linefill riskFill = na
var linefill rewardFill = na

if showLevels and (upSignal or downSignal)
    linefill.delete(riskFill)
    linefill.delete(rewardFill)
    line.delete(slLine)
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(slLabel)
    label.delete(entryLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)

    int rightEdge = bar_index + 20
    slLine := line.new(bar_index, tradeSL, rightEdge, tradeSL, color=SL_COLOR, width=2)
    entryLine := line.new(bar_index, tradeEntry, rightEdge, tradeEntry, color=ENTRY_COLOR, style=line.style_dashed, width=2)
    tp1Line := line.new(bar_index, tradeTP1, rightEdge, tradeTP1, color=TP_COLOR, style=line.style_dashed)
    tp2Line := line.new(bar_index, tradeTP2, rightEdge, tradeTP2, color=TP_COLOR, style=line.style_dashed)
    tp3Line := line.new(bar_index, tradeTP3, rightEdge, tradeTP3, color=TP_COLOR, style=line.style_dashed)
    slLabel := label.new(rightEdge, tradeSL, "SL " + f_price(tradeSL), style=label.style_label_left, color=SL_COLOR, textcolor=color.white, size=size.small)
    entryLabel := label.new(rightEdge, tradeEntry, "Entry " + f_price(tradeEntry), style=label.style_label_left, color=ENTRY_COLOR, textcolor=color.white, size=size.small)
    tp1Label := label.new(rightEdge, tradeTP1, "TP1 " + f_price(tradeTP1), style=label.style_label_left, color=TP_COLOR, textcolor=color.white, size=size.small)
    tp2Label := label.new(rightEdge, tradeTP2, "TP2 " + f_price(tradeTP2), style=label.style_label_left, color=TP_COLOR, textcolor=color.white, size=size.small)
    tp3Label := label.new(rightEdge, tradeTP3, "TP3 " + f_price(tradeTP3), style=label.style_label_left, color=TP_COLOR, textcolor=color.white, size=size.small)
    riskFill := linefill.new(slLine, entryLine, color.new(SL_COLOR, 90))
    rewardFill := linefill.new(entryLine, tp3Line, color.new(TP_COLOR, 92))

if showLevels and not na(entryLine)
    int rightEdge = (tradeOpen ? bar_index : tradeEndBar) + 20
    line.set_x2(slLine, rightEdge)
    line.set_x2(entryLine, rightEdge)
    line.set_x2(tp1Line, rightEdge)
    line.set_x2(tp2Line, rightEdge)
    line.set_x2(tp3Line, rightEdge)
    label.set_x(slLabel, rightEdge)
    label.set_x(entryLabel, rightEdge)
    label.set_x(tp1Label, rightEdge)
    label.set_x(tp2Label, rightEdge)
    label.set_x(tp3Label, rightEdge)
    label.set_text(slLabel, "SL " + f_price(tradeSL) + (slDone ? " | HIT" : ""))
    label.set_text(tp1Label, "TP1 " + f_price(tradeTP1) + (tp1Done ? " | HIT" : ""))
    label.set_text(tp2Label, "TP2 " + f_price(tradeTP2) + (tp2Done ? " | HIT" : ""))
    label.set_text(tp3Label, "TP3 " + f_price(tradeTP3) + (tp3Done ? " | HIT" : ""))

// ── TRADE PANEL ─────────────────────────────────────────────────
var table tradePanel = table.new(f_position(panelPosition), 2, 11,
     bgcolor=PANEL_BG, frame_color=#334155, frame_width=1, border_color=#253248, border_width=1)

if barstate.islast
    if showPanel
        string sideText = tradeSide == 1 ? "BUY / UP" : tradeSide == -1 ? "SELL / DOWN" : "—"
        color sideColor = tradeSide == 1 ? ENTRY_COLOR : tradeSide == -1 ? SL_COLOR : PANEL_TEXT
        color statusColor = slDone ? SL_COLOR : tradeSide == 0 ? PANEL_TEXT : TP_COLOR
        string target1Text = f_price(tradeTP1) + (tp1Done ? " | HIT" : "")
        string target2Text = f_price(tradeTP2) + (tp2Done ? " | HIT" : "")
        string target3Text = f_price(tradeTP3) + (tp3Done ? " | HIT" : "")
        table.cell(tradePanel, 0, 0, "PANEL", text_color=color.white, bgcolor=#1E3A5F, text_size=size.small)
        table.cell(tradePanel, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=color.white, bgcolor=#1E3A5F, text_size=size.small)
        f_panelRow(tradePanel, 1, "Latest Signal", sideText, sideColor)
        f_panelRow(tradePanel, 2, "Status (bar close)", tradeStatus, statusColor)
        f_panelRow(tradePanel, 3, "Entry", f_price(tradeEntry), ENTRY_COLOR)
        f_panelRow(tradePanel, 4, "Stop Loss", f_price(tradeSL) + (slDone ? " | HIT" : ""), SL_COLOR)
        f_panelRow(tradePanel, 5, "TP1 · 1R", target1Text, TP_COLOR)
        f_panelRow(tradePanel, 6, "TP2 · 2R", target2Text, TP_COLOR)
        f_panelRow(tradePanel, 7, "TP3 · 3R", target3Text, TP_COLOR)
        f_panelRow(tradePanel, 8, "Risk · price units", f_price(tradeRisk), PANEL_TEXT)
        f_panelRow(tradePanel, 9, "Trend", bullish ? "UP" : bearish ? "DOWN" : "NEUTRAL", trendColor)
        f_panelRow(tradePanel, 10, "Levels", tradeSide == 0 ? "WAITING" : tradeOpen ? "FIXED / ACTIVE" : "LAST TRADE", PANEL_TEXT)
    else
        table.clear(tradePanel, 0, 0, 1, 10)

// ── ALERT CONDITIONS ────────────────────────────────────────────
// Select individual conditions, or "Any alert() function call" for JSON details.
alertcondition(upSignal, "BUY / UP Signal", "LK Sniper — BUY / UP on {{ticker}} {{interval}}")
alertcondition(downSignal, "SELL / DOWN Signal", "LK Sniper — SELL / DOWN on {{ticker}} {{interval}}")
alertcondition(slEvent, "SL Hit", "LK Sniper — SL touched on {{ticker}} {{interval}}")
alertcondition(tp1Event, "TP1 Hit", "LK Sniper — TP1 touched on {{ticker}} {{interval}}")
alertcondition(tp2Event, "TP2 Hit", "LK Sniper — TP2 touched on {{ticker}} {{interval}}")
alertcondition(tp3Event, "TP3 Hit", "LK Sniper — TP3 touched on {{ticker}} {{interval}}")
alertcondition(reversalEvent, "Close / Reversal", "LK Sniper — Previous trade closed on opposite signal, {{ticker}} {{interval}}")