//@version=5
// ════════════════════════════════════════════════════════════════════════
//  EMA 20 Breakout & Retest — 5-minute scalping strategy
//  Rules (from "The Best 5-Minute Scalping Strategy"):
//  BUY  1) a GREEN candle crosses the 20 EMA from below and CLOSES above it
//       2) within the next 2 candles at least one RED candle forms that does NOT
//          close below the 20 EMA (a close below = setup cancelled)
//       3) enter as soon as price breaks the HIGH of that red candle (stop order,
//          no waiting for the candle to close)
//       SL: exit when a candle CLOSES below the 20 EMA
//       Target: 1:3 risk-reward (risk = entry - 20 EMA), or trail with the EMA
//  SELL is the exact mirror (red breakdown, green retest, break of its LOW).
//  Skip: no retest candle in the 2 candles; any close back across the EMA before
//  the entry; the step-1 candle did not physically cross the EMA.
//  Use the Strategy Tester tab for win rate / profit (set commission & slippage!).
// ════════════════════════════════════════════════════════════════════════
strategy("EMA 20 Breakout & Retest", "EMA20 Retest", overlay = true, initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100, pyramiding = 0,
     commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1,
     process_orders_on_close = true, calc_on_every_tick = false)

grpS = "Strategy"
emaLen    = input.int(20, "EMA length", minval = 2, group = grpS)
dirMode   = input.string("Long & Short", "Direction", options = ["Long & Short", "Long only", "Short only"], group = grpS)
retestWin = input.int(2, "Retest must appear within (candles after the breakout)", minval = 1, maxval = 5, group = grpS)
entryWait = input.int(3, "Entry must trigger within (candles after the retest window)", minval = 1, maxval = 20, group = grpS,
     tooltip = "The video says 'any subsequent candle'. After this many candles without a break of the retest high/low the setup is dropped.")
bodyCross = input.bool(true, "Step-1 candle must OPEN on the other side of the EMA (body crosses it)", group = grpS)
dayRules  = input.bool(true, "Scalping day rules: new day resets setups, close the trade on the day's last candle", group = grpS,
     tooltip = "Stops setups from yesterday filling on today's opening gap, and avoids holding scalps overnight.")

grpX = "Exits"
exitMode  = input.string("Target 1:3", "Exit", options = ["Target 1:3", "Trail with EMA (no target)"], group = grpX)
rr        = input.float(3.0, "Risk : reward (x risk)", minval = 0.5, step = 0.5, group = grpX)
hardStop  = input.bool(false, "Also place a hard stop at the EMA level (intrabar)", group = grpX,
     tooltip = "Off = exactly as the video: exit only when a candle CLOSES across the EMA.")

grpV = "Style"
showEma = input.bool(true, "Show EMA", group = grpV)
buyCol  = input.color(#089981, "BUY color", group = grpV)
sellCol = input.color(#F23645, "SELL color", group = grpV)

ema = ta.ema(close, emaLen)
longOk  = dirMode != "Short only"
shortOk = dirMode != "Long only"

// ─── Long setup state ──────────────────────────────────────────────────
var int   lStage = 0       // 0 idle, 1 waiting for retest, 2 armed (retest found)
var int   lBar = na        // breakout candle
var float lTrig = na       // high of the latest valid red retest candle
// ─── Short setup state ─────────────────────────────────────────────────
var int   sStage = 0
var int   sBar = na
var float sTrig = na

bool green = close > open
bool red   = close < open
bool upBreak = green and close > ema and (bodyCross ? open < ema : low < ema) and close[1] <= ema[1]
bool dnBreak = red and close < ema and (bodyCross ? open > ema : high > ema) and close[1] >= ema[1]

bool newDay  = ta.change(time("D")) != 0
bool lastBar = session.islastbar
if dayRules and newDay
    lStage := 0
    sStage := 0

// Long: advance the state on this closed candle
if lStage > 0
    int age = bar_index - lBar
    if close < ema
        lStage := 0                                   // closed back below EMA: void
    else
        if red and age <= retestWin
            lTrig := high
            lStage := 2
        if lStage == 1 and age >= retestWin
            lStage := 0                               // no red retest in time
        if lStage == 2 and age > retestWin + entryWait
            lStage := 0
if upBreak and lStage == 0
    lStage := 1
    lBar := bar_index
    lTrig := na

if sStage > 0
    int age = bar_index - sBar
    if close > ema
        sStage := 0
    else
        if green and age <= retestWin
            sTrig := low
            sStage := 2
        if sStage == 1 and age >= retestWin
            sStage := 0
        if sStage == 2 and age > retestWin + entryWait
            sStage := 0
if dnBreak and sStage == 0
    sStage := 1
    sBar := bar_index
    sTrig := na

// ─── Orders ────────────────────────────────────────────────────────────
// Risk = planned entry (retest high/low + 1 tick) minus the EMA at the moment the order is placed.
// Target and optional hard stop are sent together with the entry, so they work on the entry candle too.
bool useTgt = exitMode == "Target 1:3"
var float lTgt = na
var float lStp = na
var float sTgt = na
var float sStp = na
if strategy.position_size == 0
    strategy.cancel("Long")
    strategy.cancel("Short")
    if dayRules and lastBar
        lStage := 0
        sStage := 0
    if lStage == 2 and longOk
        float en = lTrig + syminfo.mintick
        lTgt := useTgt ? en + rr * (en - ema) : na
        lStp := hardStop ? ema : na
        strategy.entry("Long", strategy.long, stop = en)
        strategy.exit("L exit", "Long", limit = lTgt, stop = lStp)
    if sStage == 2 and shortOk
        float en = sTrig - syminfo.mintick
        sTgt := useTgt ? en - rr * (ema - en) : na
        sStp := hardStop ? ema : na
        strategy.entry("Short", strategy.short, stop = en)
        strategy.exit("S exit", "Short", limit = sTgt, stop = sStp)
else
    lStage := 0
    sStage := 0
    if strategy.position_size > 0 and close < ema
        strategy.close("Long", comment = "Close < EMA")
    if strategy.position_size < 0 and close > ema
        strategy.close("Short", comment = "Close > EMA")
    if dayRules and lastBar
        strategy.close_all(comment = "End of day")
bool flat = strategy.position_size == 0

// ─── Visuals ───────────────────────────────────────────────────────────
plot(showEma ? ema : na, "EMA 20", color = #2962FF, linewidth = 2)
plotshape(upBreak, "Breakout up", shape.triangleup, location.belowbar, color.new(buyCol, 50), size = size.tiny)
plotshape(dnBreak, "Breakdown", shape.triangledown, location.abovebar, color.new(sellCol, 50), size = size.tiny)
plot(lStage == 2 and flat ? lTrig : na, "Buy trigger", color = buyCol, style = plot.style_linebr)
plot(sStage == 2 and flat ? sTrig : na, "Sell trigger", color = sellCol, style = plot.style_linebr)
alertcondition(strategy.position_size > 0 and strategy.position_size[1] <= 0, "BUY entered", "EMA20 Retest: BUY {{ticker}} at {{close}}")
alertcondition(strategy.position_size < 0 and strategy.position_size[1] >= 0, "SELL entered", "EMA20 Retest: SELL {{ticker}} at {{close}}")
